  "navbar": {
    "primary": {
      "type": "button",
      "label": "Install Hum",
      "href": "https://docs.metaphi.ai/quickstart#1-install"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/metaphi-labs",
      "website": "https://metaphi.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
