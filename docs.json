{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Metaphi AI",
  "description": "Metaphi AI documentation. Hum, the agent you work with; Kennet, the infrastructure for building and running RL environments; and Harwell, which runs mainframe batch and online code off the mainframe.",
  "colors": {
    "primary": "#0b0b0a",
    "light": "#f1efe9",
    "dark": "#0b0b0a"
  },
  "logo": {
    "light": "/logo/metaphi-light.svg",
    "dark": "/logo/metaphi-dark.svg",
    "href": "https://metaphi.ai"
  },
  "favicon": {
    "light": "/logo/metaphi-favicon-light.svg",
    "dark": "/logo/metaphi-favicon-dark.svg"
  },
  "fonts": {
    "heading": {
      "family": "Newsreader",
      "weight": 500
    },
    "body": {
      "family": "Newsreader",
      "weight": 400
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "codeblocks": "dark",
    "eyebrows": "section"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Hum",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "overview",
              "quickstart"
            ]
          },
          {
            "group": "Use Hum",
            "pages": [
              "sessions",
              "slack",
              "steering",
              "asks",
              "sandbox",
              "models"
            ]
          },
          {
            "group": "Build with Hum",
            "pages": [
              "instructions",
              "plugins",
              "mcp-servers",
              "language-servers",
              "agent-teams",
              "sub-agents",
              "skills",
              "hooks",
              "unattended",
              "personas"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "commands",
              "in-a-session",
              "configuration",
              "troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Kennet",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "taskforge/overview",
              "taskforge/architecture",
              "taskforge/quickstart"
            ]
          },
          {
            "group": "The loop",
            "pages": [
              "taskforge/authoring",
              "taskforge/pre-run",
              "taskforge/conduct",
              "taskforge/post-run",
              "taskforge/consult"
            ]
          },
