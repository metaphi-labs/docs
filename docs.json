            ]
          },
          {
            "group": "Reference",
            "pages": [
              "taskforge/reference"
            ]
          }
        ]
      },
      {
        "tab": "Harwell",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "harwell/overview"
            ]
          },
          {
            "group": "Get started",
            "pages": [
              "harwell/evaluate"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "harwell/batch-runs",
              "harwell/online-runs"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "harwell/what-runs",
